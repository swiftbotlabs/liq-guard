{
  "name": "liq-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 18573",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "test": "vitest run",
    "test:relay": "node --test relay/relay.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "worker:dev": "wrangler dev --config worker/wrangler.local.toml --port 18787 --ip 127.0.0.1 --inspector-port 18229",
    "e2e": "python3 -u e2e/run_e2e.py http://127.0.0.1:18787 http://127.0.0.1:18573",
    "shots": "python3 -u e2e/shoot.py http://127.0.0.1:18573 e2e/screens",
    "preview": "vite preview --host 127.0.0.1 --port 18573 --strictPort",
    "set-api": "node scripts/set-api.mjs",
    "deploy:worker": "wrangler deploy --config worker/wrangler.toml",
    "pack": "evenhub pack app.json dist -o liq-guard.ehpk --sdk-ver 0.0.16"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251121.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8",
    "wrangler": "4.50.0"
  }
}
